# Copy to ~/.config/produce_order_workstation/launch.env and edit locally.
# Trusted Bash syntax. No API keys here! Terminal PRODUCE_* values win.
PRODUCE_RAI_ROOT="/absolute/path/to/rai"
PRODUCE_CONDA_SH="${HOME}/miniconda3/etc/profile.d/conda.sh"
PRODUCE_CONDA_ENV="rai-jazzy"
PRODUCE_ROS_SETUP="/opt/ros/jazzy/setup.bash"
# Empty if BehaviorTree.CPP is already installed in the ROS prefix.
PRODUCE_BT_PREFIX="${HOME}/.local/share/rai-deps/behaviortree-jazzy/prefix/opt/ros/jazzy"
# Omit to use RAI_ROOT/demo_assets/manipulation/RAIManipulationDemo/...
# PRODUCE_SIMULATOR_BINARY="/absolute/path/to/RAIManipulationDemo.GameLauncher"
PRODUCE_STATE_DB="${HOME}/.local/share/produce_order_workstation/workcell-mcp.sqlite3"
PRODUCE_ROS_DOMAIN_ID=0
PRODUCE_READY_TIMEOUT_S=240
# A model enabled on YOUR account, supporting tool calling; no free guarantee.
# PRODUCE_AGENT_MODEL="your-enabled-model-code"
# PRODUCE_AGENT_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# Empty = direct access; local MCP/ROS never uses this remote proxy.
PRODUCE_AGENT_PROXY_URL=""
