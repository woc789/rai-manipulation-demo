# One bounded arm/gripper motion. The order layer owns pick/place sequencing.
geometry_msgs/PoseStamped target_pose
bool initial_gripper_state
bool final_gripper_state
# Order phases: grab, lift, place, retreat. smoke is an empty-hand diagnostic.
# Gripper booleans: true=open, false=closed.
string step
---
bool success
string error
# Grab planning rejection before transit/contact/closing; never execution failure.
bool safe_to_reselect
---
string stage
