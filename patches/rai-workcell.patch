+            min(ax + a.size_x / 2, bx + b.size_x / 2)
+            - max(ax - a.size_x / 2, bx - b.size_x / 2),
+        ) * max(
+            0,
+            min(ay + a.size_y / 2, by + b.size_y / 2)
+            - max(ay - a.size_y / 2, by - b.size_y / 2),
+        )
+        union = a.size_x * a.size_y + b.size_x * b.size_y - intersection
+        return intersection / union if union > 0 else 0.0
 
