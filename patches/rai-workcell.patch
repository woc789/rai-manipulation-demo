+    def configure_tiling(self, classes, rows=3, columns=3, overlap=0.25):
+        """Optional bounded small-object pass. Disabled unless a class is selected."""
+        if (
+            not isinstance(rows, int)
+            or not isinstance(columns, int)
+            or not (1 <= rows <= 3 and 1 <= columns <= 3)
+        ):
+            raise ValueError("Detection tiling requires 1..3 rows and columns")
+        if not 0 <= overlap < 0.5:
+            raise ValueError("Detection tile overlap must be in [0, 0.5)")
+        self.tiled_classes = {name.strip().lower() for name in classes if name.strip()}
+        self.tile_rows, self.tile_columns, self.tile_overlap = rows, columns, overlap
+
+    @staticmethod
+    def tile_windows(width, height, rows, columns, overlap):
+        """Uniform overlapping image windows; no object labels or world positions."""
+        tw = width / (columns - overlap * (columns - 1))
+        th = height / (rows - overlap * (rows - 1))
+        windows = []
+        for row in range(rows):
+            for column in range(columns):
+                left = round(column * tw * (1 - overlap))
+                top = round(row * th * (1 - overlap))
+                right = min(width, round(left + tw))
+                bottom = min(height, round(top + th))
+                if right > left and bottom > top:
+                    windows.append((left, top, right, bottom))
+        return windows
+
